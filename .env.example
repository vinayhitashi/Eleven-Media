# ─── App ───────────────────────────────────────────────────────────────
# Public URL of the deployment (no trailing slash). Used for OAuth + email redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Supabase ──────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser. Used for invites, token storage and sync jobs.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Security ──────────────────────────────────────────────────────────
# 32 random bytes, base64. Generate with:  openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Shared secret Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# ─── Google / YouTube ──────────────────────────────────────────────────
# OAuth client (type "Web application") from Google Cloud Console.
# Authorized redirect URI: ${NEXT_PUBLIC_SITE_URL}/api/integrations/youtube/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional API key (YouTube Data API v3) for PUBLIC video stats on videos whose
# channel is not connected via OAuth. Public stats only — never channel analytics.
YOUTUBE_API_KEY=
